# DEVELOPMENT ONLY. Replace all passwords and JWT_SECRET before exposure to the internet.
POSTGRES_PASSWORD=local_db_admin_password
PG_APP_PASSWORD=local_app_password
DATABASE_URL=postgresql+asyncpg://proptech_app:local_app_password@postgres:5432/proptech
MIGRATION_DATABASE_URL=postgresql+psycopg://postgres:local_db_admin_password@postgres:5432/proptech
JWT_SECRET=replace_this_with_a_very_long_random_64_character_secret_key_before_deploy
CORS_ORIGINS=http://localhost:5173,http://localhost:8080
ENVIRONMENT=development
EMBEDDINGS_ENABLED=false
# To enable: build backend with INSTALL_AI=true and pre-cache multilingual model
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
MIN_TRAINING_SAMPLES=20
# Persistent private media directory mounted by Docker Compose
MAX_PROPERTY_PHOTOS=24
MAX_PHOTO_UPLOAD_MB=12
