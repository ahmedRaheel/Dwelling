# External PostgreSQL Docker network and service name. Do NOT start another PG service.
# Find actual network: docker inspect <postgres-container> --format '{{range $name, $_ := .NetworkSettings.Networks}}{{println $name}}{{end}}'
POSTGRES_DOCKER_NETWORK=replace_with_existing_network_name
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=proptech
POSTGRES_ADMIN_USER=postgres

# These MUST match passwords already in your PostgreSQL instance / desired app role.
POSTGRES_PASSWORD=replace_with_existing_admin_password
PG_APP_PASSWORD=replace_with_new_or_existing_app_role_password

# Container-to-container URLs use POSTGRES_HOST, never localhost.
# URL-encode special characters in passwords (%40 for @, %23 for #, etc.).
DATABASE_URL=postgresql+asyncpg://proptech_app:replace_with_new_or_existing_app_role_password@postgres:5432/proptech
MIGRATION_DATABASE_URL=postgresql+psycopg://postgres:replace_with_existing_admin_password@postgres:5432/proptech
JWT_SECRET=replace_with_very_long_cryptographically_random_secret_at_least_32_bytes

FRONTEND_PORT=8080
CORS_ORIGINS=http://localhost:8080
ENVIRONMENT=development
INSTALL_AI=false
EMBEDDINGS_ENABLED=false
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
MIN_TRAINING_SAMPLES=20
MAX_PROPERTY_PHOTOS=24
MAX_PHOTO_UPLOAD_MB=12
